{
  "manifest_version": 3,
  "name": "長門市役所フォーム自動入力",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["config.js", "content.js"]
    }
  ]
}
